rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return hasProfile() && profile().status == 'active' && profile().role in ['admin', 'worker']; }
    function admin() { return active() && profile().role == 'admin'; }
    function validPayment(p) {
      return p is map && p.amount is number && p.amount > 0
        && p.at is string && p.by is string && p.by == request.auth.uid;
    }
    match /users/{uid} {
      allow read: if active() || (signedIn() && request.auth.uid == uid);
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['uid','name','email','phone','role','status','createdByUid','createdAt','updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.role == 'worker'
        && request.resource.data.status == 'active' && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.email is string;
      allow update: if (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','photoData','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 15))
        && (!('photoData' in request.resource.data) || (request.resource.data.photoData is string && request.resource.data.photoData.size() < 600000))
      ) || (
        admin() && resource.data.role == 'worker'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedByUid','deletedAt','deletedByUid'])
        && request.resource.data.status in ['active','inactive','deleted']
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.status in ['active','inactive'] && !('deletedAt' in request.resource.data) && !('deletedByUid' in request.resource.data))
          || (request.resource.data.status == 'deleted'
            && request.resource.data.deletedAt == request.time
            && request.resource.data.deletedByUid == request.auth.uid)
        )
      );
      allow delete: if false;
    }
    // Legacy customer documents are readable by active staff; new workflow stores customer details on bills.
    // Archived customer markers hide customers from search without deleting bills or payments.
    match /customerArchive/{customerKey} {
      allow read: if active();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['customerKey','customerName','phone','archivedByUid','archivedByName','archivedAt'])
        && request.resource.data.customerKey == customerKey
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.archivedByUid == request.auth.uid
        && request.resource.data.archivedByName is string
        && request.resource.data.archivedAt == request.time;
      allow update, delete: if false;
    }
    match /customers/{customerDoc} { allow read: if active(); allow write: if false; }
    match /bills/{billId} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['invoiceId','customerDocId','customerUid','customerId','customerName','phone','address','service','workNote','workStatus','billDate','dueDate','paymentMode','total','paid','due','payments','createdByUid','createdByEmail','createdByName','createdByPhone','createdAt','updatedAt'])
        && request.resource.data.invoiceId is string && request.resource.data.invoiceId.size() > 0
        && request.resource.data.customerName is string && request.resource.data.customerName.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0
        && request.resource.data.get('service', '') is string && request.resource.data.get('service', '').size() > 0
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.paid is number && request.resource.data.paid >= 0 && request.resource.data.paid <= request.resource.data.total
        && request.resource.data.due == request.resource.data.total - request.resource.data.paid
        && request.resource.data.payments is list
        && ((request.resource.data.paid == 0 && request.resource.data.payments.size() == 0)
          || (request.resource.data.paid > 0 && request.resource.data.payments.size() == 1
            && validPayment(request.resource.data.payments[0])
            && request.resource.data.payments[0].amount == request.resource.data.paid))
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string && request.resource.data.createdByName.size() > 0 && request.resource.data.createdByName.size() <= 100
        && request.resource.data.createdByPhone is string && request.resource.data.createdByPhone.size() <= 15
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      // Edit bill details only; money and payment history must remain unchanged.
      allow update: if (active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerName','phone','service','workNote','workStatus','billDate','dueDate','paymentMode','updatedAt','updatedByUid'])
        && request.resource.data.total == resource.data.total
        && request.resource.data.paid == resource.data.paid
        && request.resource.data.due == resource.data.due
        && request.resource.data.payments == resource.data.payments
        && request.resource.data.customerName is string && request.resource.data.customerName.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0
        && request.resource.data.get('service', '') is string && request.resource.data.get('service', '').size() > 0
        && request.resource.data.workStatus in ['pending','in_progress','completed']
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedByUid == request.auth.uid)
        || (active()
        // Payment-only update: preserve every existing payment and append exactly one valid payment.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid','due','payments','updatedAt','updatedByUid'])
        && request.resource.data.total == resource.data.total
        && request.resource.data.paid is number && request.resource.data.paid > resource.data.paid
        && request.resource.data.paid <= resource.data.total
        && request.resource.data.due == request.resource.data.total - request.resource.data.paid
        && request.resource.data.payments is list
        && request.resource.data.payments.size() == (('payments' in resource.data) ? resource.data.payments.size() : 0) + 1
        && request.resource.data.payments.hasAll(('payments' in resource.data) ? resource.data.payments : [])
        && validPayment(request.resource.data.payments[request.resource.data.payments.size() - 1])
        && request.resource.data.payments[request.resource.data.payments.size() - 1].amount == request.resource.data.paid - resource.data.paid
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedByUid == request.auth.uid);
      // Permanent deletion is allowed only for bills already archived with a history entry.
      allow delete: if admin()
        && exists(/databases/$(database)/documents/billArchive/$(billId))
        && exists(/databases/$(database)/documents/deletedBillsHistory/$(billId));
    }
    match /expenses/{expenseId} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['title','amount','date','note','createdByUid','createdByEmail','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.date is string && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if admin();
    }
    match /billArchive/{billId} {
      allow read: if active();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['billId','invoiceId','customerName','phone','archivedByUid','archivedByName','archivedAt'])
        && request.resource.data.billId == billId
        && request.resource.data.archivedByUid == request.auth.uid
        && request.resource.data.archivedByName is string
        && request.resource.data.archivedAt == request.time;
      allow update: if false;
      // Admin may remove this marker only while permanently deleting an archived bill.
      allow delete: if admin()
        && exists(/databases/$(database)/documents/deletedBillsHistory/$(billId));
    }
    match /deletedBillsHistory/{billId} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['billId','billData','deletedByUid','deletedByName','deletedAt'])
        && request.resource.data.billId == billId
        && request.resource.data.billData is map
        && request.resource.data.deletedByUid == request.auth.uid
        && request.resource.data.deletedByName is string
        && request.resource.data.deletedAt == request.time;
      allow update: if false;
      allow delete: if admin();
    }

    // MJK_SCHOOL_ID_CARD_RULES_V1
    match /schoolIdCards/{cardId} {
      allow read: if active();

      allow create: if active()
        && request.resource.data.keys().hasAll([
          'studentName','studentId','fatherName','motherName','schoolId',
          'schoolName','schoolAddress','schoolPhone','className',
          'section','rollNumber','dob','phone','academicYear',
          'studentPhoto','schoolLogo','orientation','createdByUid','createdByName',
          'createdAt','updatedAt','updatedByUid','updatedByName','deleted'
        ])
        && request.resource.data.keys().hasOnly([
          'studentName','studentId','fatherName','motherName','schoolId',
          'schoolName','schoolAddress','schoolPhone','className',
          'section','rollNumber','dob','phone','academicYear',
          'studentPhoto','schoolLogo','orientation','createdByUid','createdByName',
          'createdAt','updatedAt','updatedByUid','updatedByName',
          'deleted','deletedAt','deletedByUid','deletedByName'
        ])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 100
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() <= 40
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.size() <= 100
        && (request.resource.data.schoolId == '' || exists(/databases/$(database)/documents/schoolIdSchools/$(request.resource.data.schoolId)))
        && request.resource.data.orientation is string
        && request.resource.data.orientation in ['landscape', 'portrait']
        && request.resource.data.fatherName is string
        && request.resource.data.motherName is string
        && request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() <= 150
        && request.resource.data.schoolAddress is string
        && request.resource.data.className is string
        && request.resource.data.section is string
        && request.resource.data.rollNumber is string
        && request.resource.data.dob is string
        && request.resource.data.phone is string
        && request.resource.data.academicYear is string
        && request.resource.data.studentPhoto is string
        && request.resource.data.studentPhoto.size() < 400000
        && request.resource.data.schoolLogo is string
        && request.resource.data.schoolLogo.size() < 200000
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.deleted == false
        && !('deletedAt' in request.resource.data)
        && !('deletedByUid' in request.resource.data)
        && !('deletedByName' in request.resource.data);

      allow update: if active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentName','studentId','fatherName','motherName','schoolId',
          'schoolName','schoolAddress','schoolPhone','className',
          'section','rollNumber','dob','phone','academicYear',
          'studentPhoto','schoolLogo','orientation','updatedAt','updatedByUid',
          'updatedByName','deleted','deletedAt','deletedByUid','deletedByName'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.deleted is bool
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 100
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() <= 40
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.size() <= 100
        && (request.resource.data.schoolId == '' || exists(/databases/$(database)/documents/schoolIdSchools/$(request.resource.data.schoolId)))
        && (!('orientation' in request.resource.data)
          || (request.resource.data.orientation is string
            && request.resource.data.orientation in ['landscape', 'portrait']))
        && request.resource.data.studentPhoto is string
        && request.resource.data.studentPhoto.size() < 400000
        && request.resource.data.schoolLogo is string
        && request.resource.data.schoolLogo.size() < 200000
        && (
          (request.resource.data.deleted == false
            && !('deletedAt' in request.resource.data)
            && !('deletedByUid' in request.resource.data)
            && !('deletedByName' in request.resource.data))
          ||
          (request.resource.data.deleted == true
            && request.resource.data.deletedAt == request.time
            && request.resource.data.deletedByUid == request.auth.uid
            && request.resource.data.deletedByName is string)
        );

      // Keep the record for recovery and audit; no permanent deletion.
      allow delete: if false;

      match /history/{historyId} {
        allow read: if active();
        allow create: if active()
          && request.resource.data.keys().hasOnly([
            'action','byUid','byName','at','details'
          ])
          && request.resource.data.keys().hasAll([
            'action','byUid','byName','at','details'
          ])
          && request.resource.data.action in [
            'created','updated','deleted','restored'
          ]
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.byName is string
          && request.resource.data.at == request.time
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 250;
        allow update, delete: if false;
      }
    }

    // MJK_SCHOOL_ID_SCHOOL_REGISTRY_V1
    match /schoolIdSchools/{schoolId} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasAll([
          'name','schoolAddress','schoolPhone','cardTemplateLandscape','cardTemplatePortrait',
          'templateMappingLandscape','templateMappingPortrait','createdByUid','createdByName',
          'createdAt','updatedAt','updatedByUid','updatedByName'
        ])
        && request.resource.data.keys().hasOnly([
          'name','schoolAddress','schoolPhone','cardTemplateLandscape','cardTemplatePortrait',
          'templateMappingLandscape','templateMappingPortrait','createdByUid','createdByName',
          'createdAt','updatedAt','updatedByUid','updatedByName'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150
        && request.resource.data.schoolAddress is string
        && request.resource.data.schoolAddress.size() <= 250
        && request.resource.data.schoolPhone is string
        && request.resource.data.schoolPhone.size() <= 15
        && request.resource.data.cardTemplateLandscape is string
        && request.resource.data.cardTemplateLandscape.size() < 350000
        && request.resource.data.cardTemplatePortrait is string
        && request.resource.data.cardTemplatePortrait.size() < 350000
        && request.resource.data.templateMappingLandscape is map
        && request.resource.data.templateMappingLandscape.keys().hasOnly([
          'schoolName','schoolAddress','studentName','studentId','fatherName','motherName',
          'className','section','rollNumber','dob','schoolPhone','phone','academicYear',
          'studentPhoto','schoolLogo'
        ])
        && request.resource.data.templateMappingPortrait is map
        && request.resource.data.templateMappingPortrait.keys().hasOnly([
          'schoolName','schoolAddress','studentName','studentId','fatherName','motherName',
          'className','section','rollNumber','dob','schoolPhone','phone','academicYear',
          'studentPhoto','schoolLogo'
        ])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string;
      allow update: if active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','schoolAddress','schoolPhone','cardTemplateLandscape','cardTemplatePortrait',
          'templateMappingLandscape','templateMappingPortrait','updatedAt','updatedByUid','updatedByName'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150
        && request.resource.data.schoolAddress is string
        && request.resource.data.schoolAddress.size() <= 250
        && request.resource.data.schoolPhone is string
        && request.resource.data.schoolPhone.size() <= 15
        && request.resource.data.cardTemplateLandscape is string
        && request.resource.data.cardTemplateLandscape.size() < 350000
        && request.resource.data.cardTemplatePortrait is string
        && request.resource.data.cardTemplatePortrait.size() < 350000
        && request.resource.data.templateMappingLandscape is map
        && request.resource.data.templateMappingLandscape.keys().hasOnly([
          'schoolName','schoolAddress','studentName','studentId','fatherName','motherName',
          'className','section','rollNumber','dob','schoolPhone','phone','academicYear',
          'studentPhoto','schoolLogo'
        ])
        && request.resource.data.templateMappingPortrait is map
        && request.resource.data.templateMappingPortrait.keys().hasOnly([
          'schoolName','schoolAddress','studentName','studentId','fatherName','motherName',
          'className','section','rollNumber','dob','schoolPhone','phone','academicYear',
          'studentPhoto','schoolLogo'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string;
      allow delete: if false;
    }

    // Public menu link is readable by visitors; only an active admin can change it.
    match /publicSiteConfig/{configId} {
      allow read: if configId == 'cscKendra';
      allow create: if configId == 'cscKendra' && admin()
        && request.resource.data.keys().hasAll(['websiteName','websiteUrl','updatedAt','updatedByUid','updatedByName'])
        && request.resource.data.keys().hasOnly(['websiteName','websiteUrl','updatedAt','updatedByUid','updatedByName'])
        && request.resource.data.websiteName is string
        && request.resource.data.websiteName.size() > 0
        && request.resource.data.websiteName.size() <= 100
        && request.resource.data.websiteUrl is string
        && request.resource.data.websiteUrl.size() > 0
        && request.resource.data.websiteUrl.size() <= 500
        && (request.resource.data.websiteUrl.matches('https?://.*'))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByName.size() <= 100;
      allow update: if configId == 'cscKendra' && admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['websiteName','websiteUrl','updatedAt','updatedByUid','updatedByName'])
        && request.resource.data.keys().hasAll(['websiteName','websiteUrl','updatedAt','updatedByUid','updatedByName'])
        && request.resource.data.keys().hasOnly(['websiteName','websiteUrl','updatedAt','updatedByUid','updatedByName'])
        && request.resource.data.websiteName is string
        && request.resource.data.websiteName.size() > 0
        && request.resource.data.websiteName.size() <= 100
        && request.resource.data.websiteUrl is string
        && request.resource.data.websiteUrl.size() > 0
        && request.resource.data.websiteUrl.size() <= 500
        && request.resource.data.websiteUrl.matches('https?://.*')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByName.size() <= 100;
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
